<nav class="nav" aria-label="Main">
  {% set navPages = collections.all | eleventyNavigation %}
  <ul class="nav-list">
    {%- for entry in navPages %}
      <li>
        <a href="{{ entry.url | url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a>
      </li>
    {%- endfor %}
  </ul>
</nav>
