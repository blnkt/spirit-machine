---
layout: layouts/base.njk
section: calendar
---
<div class="content-wrap">
  <h1>{{ title }}</h1>
  {{ content | safe }}

  <section class="events-upcoming">
    <h2>Upcoming</h2>
    {% if collections.upcomingEvents | length %}
      <div class="event-list">
        {% for item in collections.upcomingEvents %}
          {% include "components/event-card.njk" %}
        {% endfor %}
      </div>
    {% else %}
      <p>No upcoming events scheduled. Check back soon.</p>
    {% endif %}
  </section>

  <section class="events-past">
    <h2>Past</h2>
    {% if collections.pastEvents | length %}
      <div class="event-list">
        {% for item in collections.pastEvents %}
          {% include "components/event-card.njk" %}
        {% endfor %}
      </div>
    {% else %}
      <p>No past events listed yet.</p>
    {% endif %}
  </section>
</div>
