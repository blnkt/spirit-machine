---
layout: layouts/base.njk
section: post
---
<div class="content-wrap prose">
  <article>
    <h1>{{ title }}</h1>
    <p class="post-meta">
      <time datetime="{{ page.date | machineDate }}">{{ page.date | readableDate }}</time>
    </p>
    {{ content | safe }}
  </article>
  <nav class="page-nav">
    <a href="{{ '/news/' | url }}">← News</a>
  </nav>
</div>
