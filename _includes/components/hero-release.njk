{% if release %}
<article class="hero-release">
  <p class="label-new-release">New release</p>
  <div class="hero-release-inner">
    {% if release.data.coverImage %}
      <img class="hero-release-cover" src="{{ release.data.coverImage | url }}" alt="{{ release.data.title }} cover art" width="280" height="280">
    {% endif %}
    <div class="hero-release-meta">
      <h3 class="hero-release-title">{{ release.data.title }}</h3>
      <p class="release-type">{{ release.data.releaseType }} • {{ release.data.year }}</p>
      {% if release.data.listenUrl %}
        <p>
          <a class="listen-link" href="{{ release.data.listenUrl }}" rel="noopener noreferrer">
            Listen<span class="visually-hidden"> to {{ release.data.title }} (opens in new tab)</span>
          </a>
        </p>
      {% endif %}
    </div>
  </div>
</article>
{% endif %}
