---
layout: layouts/base.njk
section: event
---
<div class="content-wrap prose">
  <article class="event-detail">
    <h1>{{ title }}</h1>
    <p class="event-dates">{{ startDate | eventDateRange(endDate) }}</p>
    {% if venue %}
      <p class="event-venue">{{ venue }}{% if location %}, {{ location }}{% endif %}</p>
    {% endif %}
    {% if ticketUrl %}
      <p>
        <a class="button button-accent" href="{{ ticketUrl }}" rel="noopener noreferrer" target="_blank">
          Tickets<span class="visually-hidden"> (opens in new tab)</span>
        </a>
      </p>
    {% endif %}
    {{ content | safe }}
  </article>
  <nav class="page-nav" aria-label="Event">
    <a href="{{ '/calendar/' | url }}">← Calendar</a>
  </nav>
</div>
