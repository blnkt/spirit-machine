---
layout: layouts/base.njk
section: home
---

{% set featuredEvent = collections.featuredEvent[0] %}

<div class="home-page">
  <h1 class="visually-hidden">{{ site.choirName or metadata.title }}</h1>

  {% if featuredEvent %}
    <div class="hero-bleed">
      {% set event = featuredEvent %}
      {% set headingLevel = 2 %}
      {% include "components/hero-event.njk" %}
    </div>
  {% endif %}

  <div class="content-wrap">
    {% if content %}
      <div class="home-intro prose">
        {{ content | safe }}
      </div>
    {% endif %}
  </div>
</div>
