<form class="contact-form" name="contact" method="POST" data-netlify="true" novalidate>
  <input type="hidden" name="form-name" value="contact">
  <p class="visually-hidden" aria-hidden="true">
    <label for="contact-bot-field">Leave this field empty</label>
    <input type="text" id="contact-bot-field" name="bot-field" tabindex="-1" autocomplete="off">
  </p>

  <div class="form-field">
    <label for="name">Name <span class="required-indicator">(required)</span></label>
    <input
      type="text"
      name="name"
      id="name"
      autocomplete="name"
      required
      aria-required="true"
      aria-describedby="name-error"
    >
    <span id="name-error" class="field-error" role="alert"></span>
  </div>

  <div class="form-field">
    <label for="email">Email <span class="required-indicator">(required)</span></label>
    <input
      type="email"
      name="email"
      id="email"
      autocomplete="email"
      required
      aria-required="true"
      aria-describedby="email-error"
      pattern="^[^\s@]+@[^\s@]+\.[^\s@]+$"
    >
    <span id="email-error" class="field-error" role="alert"></span>
  </div>

  <div class="form-field">
    <label for="message">Message <span class="required-indicator">(required)</span></label>
    <textarea
      name="message"
      id="message"
      rows="7"
      required
      aria-required="true"
      aria-describedby="message-error"
    ></textarea>
    <span id="message-error" class="field-error" role="alert"></span>
  </div>

  <button type="submit">Send message</button>
</form>
