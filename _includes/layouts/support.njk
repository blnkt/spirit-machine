---
layout: layouts/base.njk
section: support
---
<div class="content-wrap prose">
  <h1>{{ title }}</h1>

  <h2>Spring 2026 membership dues</h2>
  <p>Tuition is due by <strong>February 1st</strong> (installments available on request).</p>

  {% include "components/tier-cards.njk" %}

  {{ content | safe }}

  <p class="support-cta">
    <a class="button" href="{{ '/contact/' | url }}">Join or ask about scholarships</a>
  </p>
  {% if site.donateUrl %}
    <p class="support-secondary">
      <a href="{{ site.donateUrl }}" rel="noopener noreferrer" target="_blank">
        Additional financial support<span class="visually-hidden"> (opens in new tab)</span>
      </a>
    </p>
  {% endif %}
</div>
