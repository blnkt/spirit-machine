---
layout: layouts/base.njk
section: post
---

<article>
  <h1>{{ title }}</h1>
  <p>
    <small>
      <time datetime="{{ page.date | machineDate }}">{{ page.date | readableDate }}</time>
    </small>
  </p>

  {{ content | safe }}
</article>

<nav>
  <a href="{{ '/news/' | url }}">← News</a>
</nav>
