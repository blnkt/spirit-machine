<article class="event-card{% if past %} event-card-past{% endif %}">
  <div class="event-card-date">
    <time datetime="{{ item.data.startDate | machineDate }}">{{ item.data.startDate | eventDateRange(item.data.endDate) }}</time>
  </div>
  <div class="event-card-body">
    <h2><a href="{{ item.url | url }}">{{ item.data.title }}</a></h2>
    {% if item.data.venue %}
      <p class="event-venue">{{ item.data.venue }}{% if item.data.location %}, {{ item.data.location }}{% endif %}</p>
    {% endif %}
    {% if item.data.summary %}
      <p>{{ item.data.summary }}</p>
    {% endif %}
    {% if item.data.ticketUrl %}
      <p>
        <a class="button button-accent" href="{{ item.data.ticketUrl }}" rel="noopener noreferrer" target="_blank">
          Tickets<span class="visually-hidden"> (opens in new tab)</span>
        </a>
      </p>
    {% endif %}
  </div>
</article>
